<Window x:Class="TungDiroot.Addin.UI.TargetViewPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TUNG_DIROOT — Đổi View đích" Width="620" Height="210" MinWidth="520" MinHeight="190"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Chọn View đích mới" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1" Text="Tool sẽ dựng lại bảng ở View mới; nếu có lỗi, toàn bộ thao tác được rollback." Foreground="#56616F" Margin="0,4,0,10" TextWrapping="Wrap"/>
    <ComboBox x:Name="TargetViewBox" Grid.Row="2" DisplayMemberPath="Name" Padding="8" VerticalAlignment="Top"/>
    <StackPanel x:Name="PickerButtons" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="MoveButton" Content="Đổi View" Click="Move_Click" Padding="18,7" Margin="0,0,8,0" Background="#A84CC1" Foreground="White"/>
      <Button x:Name="CancelButton" Content="Hủy" Click="Cancel_Click" Padding="18,7"/>
    </StackPanel>
  </Grid>
</Window>

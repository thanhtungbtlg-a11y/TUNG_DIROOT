<Window x:Class="TungDiroot.Addin.UI.TableGenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TUNG_DIROOT — TableGen" Width="1800" Height="980" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="HeaderPanel" Margin="0,0,0,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel x:Name="TitlePanel" Grid.Row="0">
        <TextBlock Text="Quản lý liên kết Excel — Revit" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="Kiểm tra nguồn, cập nhật và điều khiển Auto Sync trong một cửa sổ." Foreground="#56616F"/>
      </StackPanel>
      <WrapPanel x:Name="MainToolbar" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
        <Button Content="+ Thêm Excel" Command="{Binding AddExcelCommand}" MinWidth="112" Padding="12,7" Margin="0,0,8,8"/>
        <Button Content="PDF / Word" Click="DocumentLink_Click" MinWidth="104" Padding="12,7" Margin="0,0,8,8"
                ToolTip="Nhập nhiều trang PDF/Word vào Drafting View và theo dõi liên kết nguồn.">
          <Button.Style>
            <Style TargetType="Button">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button Content="Kiểm tra nguồn" Command="{Binding CheckSourcesCommand}" MinWidth="126" Padding="12,7" Margin="0,0,8,8"/>
        <Button Content="Relink thư mục" Command="{Binding RelinkFolderCommand}" MinWidth="122" Padding="12,7" Margin="0,0,8,8"/>
        <Button Content="Lưu Auto Sync" Command="{Binding SaveAutoSyncCommand}" MinWidth="116" Padding="12,7" Margin="0,0,8,8"/>
        <Button Content="Sync tất cả"
                Command="{Binding SyncAllCommand}"
                MinWidth="100"
                Padding="12,7"
                Margin="0,0,8,8"
                ToolTip="Kiểm tra và cập nhật mọi liên kết Excel đã nạp; tự bỏ qua nguồn không đổi."/>
        <Button Content="Cập nhật đã chọn" Command="{Binding UpdateSelectedCommand}" MinWidth="138" Padding="12,7" Margin="0,0,8,8" Background="#A84CC1" Foreground="White"/>
        <Button Content="Dựng lại bảng" Command="{Binding RecreateLinkCommand}" MinWidth="118" Padding="12,7" Margin="0,0,8,8"
                ToolTip="Chọn đúng một liên kết để dựng lại từ Excel sau khi xác nhận. Chỉnh sửa thủ công có thể mất; giữ nguyên chế độ cập nhật đã lưu."/>
        <Button Content="Tạm dừng" Command="{Binding PauseBatchCommand}" MinWidth="88" Padding="10,7" Margin="0,0,8,8"/>
        <Button Content="Tiếp tục" Command="{Binding ResumeBatchCommand}" MinWidth="88" Padding="10,7" Margin="0,0,8,8"/>
        <Button Content="Dừng" Command="{Binding StopBatchCommand}" MinWidth="72" Padding="10,7" Margin="0,0,8,8"/>
      </WrapPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
      <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" ToolTip="Tìm theo file, worksheet, vùng hoặc view"/>
      <ComboBox Grid.Column="1" x:Name="StatusFilterBox" SelectedItem="{Binding StatusFilter}" Margin="8,0,0,0" Padding="7"/>
    </Grid>
    <WrapPanel x:Name="LinkActionsToolbar" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
      <TextBlock Text="Liên kết đã tích:" VerticalAlignment="Center" Margin="0,0,10,8" FontWeight="SemiBold"/>
      <Button Content="Mở View" Command="{Binding OpenViewCommand}" MinWidth="88" Padding="10,6" Margin="0,0,8,8"/>
      <Button Content="Mở Excel" Command="{Binding OpenSourceCommand}" MinWidth="88" Padding="10,6" Margin="0,0,8,8"/>
      <Button Content="Mở thư mục" Command="{Binding OpenSourceFolderCommand}" MinWidth="96" Padding="10,6" Margin="0,0,8,8"/>
      <Button Content="Đổi View đích" Command="{Binding ChangeTargetViewCommand}" MinWidth="112" Padding="10,6" Margin="0,0,8,8"
              ToolTip="Dựng lại bảng trong một View tương thích; rollback toàn bộ nếu thất bại."/>
      <Button Content="Nhân cấu hình" Command="{Binding DuplicateConfigurationCommand}" MinWidth="108" Padding="10,6" Margin="0,0,8,8"
              ToolTip="Mở một bản sao cấu hình trong Thêm Excel để chỉnh trước khi Import."/>
      <Button Content="Unlink — giữ View" Command="{Binding UnlinkKeepViewCommand}" MinWidth="132" Padding="10,6" Margin="0,0,8,8"
              ToolTip="Bỏ liên kết Excel nhưng giữ nguyên View và toàn bộ bảng hiện tại."/>
      <Button Content="Xóa link + View" Command="{Binding DeleteLinkAndViewCommand}" MinWidth="126" Padding="10,6" Margin="0,0,8,8"
              Foreground="#B3261E" ToolTip="Xóa liên kết và View đích. Tool sẽ hỏi xác nhận trước khi thực hiện."/>
    </WrapPanel>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
      <DataGrid x:Name="LinksGrid" ItemsSource="{Binding VisibleLinks}" AutoGenerateColumns="False"
                CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="FullRow" GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Chọn" Width="52">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Click="RowCheckBox_Click" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status, Mode=OneWay}" IsReadOnly="True" Width="88"/>
          <DataGridTextColumn Header="Nguồn Excel" Binding="{Binding SourcePath, Mode=OneWay}" IsReadOnly="True" Width="*"/>
          <DataGridTextColumn Header="Worksheet" Binding="{Binding WorksheetName, Mode=OneWay}" IsReadOnly="True" Width="120"/>
          <DataGridTextColumn Header="Vùng" Binding="{Binding RegionReference, Mode=OneWay}" IsReadOnly="True" Width="88"/>
          <DataGridTextColumn Header="View đích" Binding="{Binding TargetViewName, Mode=OneWay}" IsReadOnly="True" Width="170"/>
          <DataGridTextColumn Header="Chế độ" Binding="{Binding ImportMode, Mode=OneWay}" IsReadOnly="True" Width="90"/>
          <DataGridTextColumn Header="Loại view" Binding="{Binding TargetViewKind, Mode=OneWay}" IsReadOnly="True" Width="90"/>
          <DataGridTextColumn Header="Cập nhật" Binding="{Binding UpdateBehavior, Mode=OneWay}" IsReadOnly="True" Width="90"/>
          <DataGridTextColumn Header="Renderer" Binding="{Binding RendererDisplay, Mode=OneWay}" IsReadOnly="True" Width="165"/>
          <DataGridTemplateColumn Header="Auto Sync" Width="78">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding AutoSync, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Click="RowCheckBox_Click" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <Border Grid.Column="1" Margin="10,0,0,0" BorderBrush="#D7DCE2" BorderThickness="1" Padding="12">
        <StackPanel>
          <TextBlock Text="Tổng quan" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
          <TextBlock Text="{Binding ReadyCount, StringFormat=Sẵn sàng: {0}}"/>
          <TextBlock Text="{Binding ChangedCount, StringFormat=Đã thay đổi: {0}}" Foreground="#A05A00"/>
          <TextBlock Text="{Binding MissingCount, StringFormat=Mất nguồn: {0}}" Foreground="#B3261E"/>
          <TextBlock Text="{Binding ErrorCount, StringFormat=Lỗi: {0}}" Foreground="#B3261E"/>
          <Separator Margin="0,12"/>
          <TextBlock Text="Cập nhật theo từng view và rollback riêng nếu một view lỗi." TextWrapping="Wrap" Foreground="#56616F"/>
        </StackPanel>
      </Border>
    </Grid>
    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,10,0">
        <TextBlock Text="{Binding BatchStatusText}" Foreground="#6C2B91"/>
        <TextBlock Text="Auto Sync không tự lưu model và không Synchronize with Central." TextTrimming="CharacterEllipsis" Foreground="#56616F"/>
      </StackPanel>
      <Button Grid.Column="1" Content="Đóng" Click="Close_Click" Padding="18,7" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</Window>

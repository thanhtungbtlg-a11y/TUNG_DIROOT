<Window x:Class="TungDiroot.Addin.UI.WorkbookPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TUNG_DIROOT — Xem trước Excel" Width="1200" Height="760" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10">
      <TextBlock Text="Xem trước vùng Excel" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding SourceLabel}" Foreground="#56616F" TextTrimming="CharacterEllipsis"/>
      <WrapPanel Margin="0,6,0,0">
        <TextBlock Text="{Binding DimensionsText}" Margin="0,0,18,0"/>
        <TextBlock Text="{Binding EstimateText}" Margin="0,0,18,0"/>
        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="#6C2B91"/>
      </WrapPanel>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <Border BorderBrush="#D7DCE2" BorderThickness="1" Background="White">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Image x:Name="PreviewImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </ScrollViewer>
      </Border>
      <GroupBox Grid.Column="1" Header="Chẩn đoán" Margin="10,0,0,0" Padding="6">
        <DataGrid x:Name="IssuesGrid" ItemsSource="{Binding Issues}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" GridLinesVisibility="Horizontal">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Mức" Binding="{Binding SeverityText}" Width="82"/>
            <DataGridTextColumn Header="Ô" Binding="{Binding CellAddress}" Width="62"/>
            <DataGridTextColumn Header="Nội dung" Binding="{Binding Message}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </GroupBox>
    </Grid>
    <Grid x:Name="PreviewFooterPanel" Grid.Row="2" Margin="0,12,0,0">
      <TextBlock Text="Preview dùng renderer tích hợp, không chạy macro và không sửa file Excel."
                 VerticalAlignment="Center" Foreground="#56616F" TextTrimming="CharacterEllipsis" Margin="0,0,100,0"/>
      <Button x:Name="PreviewCloseButton" Content="Đóng" Click="Close_Click" Padding="18,7" HorizontalAlignment="Right"/>
    </Grid>
  </Grid>
</Window>


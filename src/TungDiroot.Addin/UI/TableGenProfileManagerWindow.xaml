<Window x:Class="TungDiroot.Addin.UI.TableGenProfileManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TUNG_DIROOT — Profile TableGen" Width="1200" Height="760" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Profile trình bày TableGen" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="Ánh xạ style tìm thấy trong vùng Excel sang Text Type và Line Style của model hiện tại." Foreground="#56616F"/>
    </StackPanel>
    <WrapPanel x:Name="ProfileToolbar" Grid.Row="1" Margin="0,12,0,10">
      <TextBlock Text="Profile đã lưu:" VerticalAlignment="Center" Margin="0,0,8,8"/>
      <ComboBox x:Name="SavedProfilesBox" MinWidth="240" DisplayMemberPath="Name" Padding="6" Margin="0,0,8,8"/>
      <Button Content="Nạp" Click="LoadProfile_Click" Padding="13,6" Margin="0,0,8,8"/>
      <Button Content="Xóa" Click="DeleteProfile_Click" Padding="13,6" Margin="0,0,18,8"/>
      <TextBlock Text="Tên profile mới / cập nhật:" VerticalAlignment="Center" Margin="0,0,8,8"/>
      <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" MinWidth="230" Padding="7,5" Margin="0,0,8,8"/>
    </WrapPanel>
    <GroupBox Grid.Row="2" Header="Quy tắc hiển thị số" Padding="8" Margin="0,0,0,10">
      <WrapPanel x:Name="NumberOptionsPanel">
        <CheckBox Content="Giữ định dạng Excel" IsChecked="{Binding KeepExcelFormat}" VerticalAlignment="Center" Margin="0,0,18,8"/>
        <TextBlock Text="Dấu thập phân" VerticalAlignment="Center" Margin="0,0,6,8"/>
        <TextBox Text="{Binding DecimalSymbol, UpdateSourceTrigger=PropertyChanged}" Width="42" Padding="5" Margin="0,0,14,8"/>
        <CheckBox Content="Phân nhóm hàng nghìn" IsChecked="{Binding UseThousandsSeparator}" VerticalAlignment="Center" Margin="0,0,14,8"/>
        <TextBlock Text="Dấu nhóm" VerticalAlignment="Center" Margin="0,0,6,8"/>
        <TextBox Text="{Binding ThousandsSeparator, UpdateSourceTrigger=PropertyChanged}" Width="42" Padding="5" Margin="0,0,14,8"/>
        <TextBlock Text="Số chữ số thập phân" VerticalAlignment="Center" Margin="0,0,6,8"/>
        <TextBox Text="{Binding DecimalPlaces, UpdateSourceTrigger=PropertyChanged}" Width="54" Padding="5" Margin="0,0,0,8"/>
      </WrapPanel>
    </GroupBox>
    <DataGrid x:Name="MappingsGrid" Grid.Row="3" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
              CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Loại" Binding="{Binding Kind}" Width="80" IsReadOnly="True"/>
        <DataGridTextColumn Header="Style Excel" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
        <DataGridTemplateColumn Header="Revit Text Type" Width="250">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding DataContext.TextNoteTypes, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                        SelectedValue="{Binding SelectedTextNoteTypeUniqueId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="UniqueId" DisplayMemberPath="Name" IsEnabled="{Binding IsTextStyle}" Padding="4"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Revit Line Style" Width="250">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding DataContext.GraphicsStyles, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                        SelectedValue="{Binding SelectedGraphicsStyleUniqueId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="UniqueId" DisplayMemberPath="Name" IsEnabled="{Binding IsLineStyle}" Padding="4"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <Grid x:Name="ProfileFooter" Grid.Row="4" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#6C2B91" Margin="0,0,10,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="SaveProfileButton" Content="Lưu profile" Click="SaveProfile_Click" Padding="18,7" Margin="0,0,8,0" Background="#A84CC1" Foreground="White"/>
        <Button x:Name="CloseProfileButton" Content="Đóng" Click="Close_Click" Padding="18,7"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>

<Window x:Class="TungDiroot.Addin.UI.BulkVgWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TUNG_DIROOT — Bulk Visibility &amp; Graphics" Width="1500" Height="900"
        MinWidth="780" MinHeight="560" WindowStartupLocation="CenterScreen">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10">
      <TextBlock Text="Bulk Visibility &amp; Graphics Manager" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="Sao chép Category/Filter overrides từ View hoặc View Template sang nhiều đích; Sheet tự lấy các Viewport." Foreground="#56616F"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,0,0,10">
    <WrapPanel x:Name="BulkVgToolbar">
      <TextBlock Text="Nguồn" VerticalAlignment="Center" Margin="0,0,8,8"/>
      <ComboBox x:Name="SourceViewBox" Width="360" Padding="7" Margin="0,0,12,8" DisplayMemberPath="DisplayName"
                SelectionChanged="SourceView_SelectionChanged"/>
      <TextBlock Text="Chế độ" VerticalAlignment="Center" Margin="0,0,8,8"/>
      <ComboBox x:Name="ModeBox" Width="170" Padding="7" Margin="0,0,12,8" DisplayMemberPath="DisplayName"
                SelectionChanged="Mode_SelectionChanged"/>
      <CheckBox x:Name="VisibilityCheck" Content="Visibility" IsChecked="True" Margin="0,0,10,8" VerticalAlignment="Center"/>
      <CheckBox x:Name="ProjectionCheck" Content="Projection" IsChecked="True" Margin="0,0,10,8" VerticalAlignment="Center"/>
      <CheckBox x:Name="CutCheck" Content="Cut" IsChecked="True" Margin="0,0,10,8" VerticalAlignment="Center"/>
      <CheckBox x:Name="FillCheck" Content="Fill/Pattern" IsChecked="True" Margin="0,0,10,8" VerticalAlignment="Center"/>
      <CheckBox x:Name="TransparencyCheck" Content="Transparency/Halftone" IsChecked="True" Margin="0,0,10,8" VerticalAlignment="Center"/>
    </WrapPanel>
    <TextBlock x:Name="ModeHelpText" TextWrapping="Wrap" Foreground="#56616F"/>
    </StackPanel>

    <Grid Grid.Row="2" Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <GroupBox Header="Đích — View / View Template / Sheet" Margin="0,0,6,0">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="6">
            <Button Content="Chọn tất cả" Click="SelectAllTargets_Click" Padding="9,5" Margin="0,0,6,0"/>
            <Button Content="Bỏ chọn" Click="ClearTargets_Click" Padding="9,5"/>
          </WrapPanel>
          <DataGrid x:Name="TargetsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Chọn" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
              </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="Đích" Binding="{Binding DisplayName}" IsReadOnly="True" Width="*"/>
              <DataGridTextColumn Header="Loại" Binding="{Binding Kind}" IsReadOnly="True" Width="100"/>
              <DataGridTextColumn Header="Viewports" Binding="{Binding ViewportCount}" IsReadOnly="True" Width="78"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </GroupBox>
      <GroupBox Grid.Column="1" Header="Category / Filter từ nguồn" Margin="6,0,0,0">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="6">
            <Button Content="Chọn tất cả" Click="SelectAllItems_Click" Padding="9,5" Margin="0,0,6,0"/>
            <Button Content="Bỏ chọn" Click="ClearItems_Click" Padding="9,5"/>
          </WrapPanel>
          <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Chọn" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
              </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="Loại" Binding="{Binding Kind}" IsReadOnly="True" Width="80"/>
              <DataGridTextColumn Header="Tên" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </GroupBox>
    </Grid>

    <GroupBox Grid.Row="3" Header="Xem trước khác biệt">
      <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Đích" Binding="{Binding TargetName}" IsReadOnly="True" Width="1.2*"/>
          <DataGridTextColumn Header="Category / Filter" Binding="{Binding ItemName}" IsReadOnly="True" Width="*"/>
          <DataGridTextColumn Header="Khác biệt" Binding="{Binding Differences}" IsReadOnly="True" Width="1.2*"/>
          <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" IsReadOnly="True" Width="160"/>
        </DataGrid.Columns>
      </DataGrid>
    </GroupBox>

    <Grid x:Name="BulkVgFooter" Grid.Row="4" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="Sẵn sàng" Foreground="#6C2B91" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <WrapPanel Grid.Column="1">
        <Button Content="Xem trước" Click="Preview_Click" Padding="12,7" Margin="0,0,8,0"/>
        <Button x:Name="RestoreButton" Content="Khôi phục lần Apply gần nhất" Click="Restore_Click" Padding="12,7" Margin="0,0,8,0" IsEnabled="False"/>
        <Button x:Name="ApplyButton" Content="Apply đã chọn" Click="Apply_Click" Padding="14,7" Margin="0,0,8,0" Background="#A84CC1" Foreground="White"/>
        <Button Content="Đóng" Click="Close_Click" Padding="18,7"/>
      </WrapPanel>
    </Grid>
  </Grid>
</Window>

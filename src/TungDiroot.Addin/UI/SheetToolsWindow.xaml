<Window x:Class="TungDiroot.Addin.UI.SheetToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TUNG_DIROOT — SheetLink / SheetGen" Width="1500" Height="900"
        MinWidth="780" MinHeight="560" WindowStartupLocation="CenterScreen">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,10">
      <TextBlock Text="SheetLink / SheetGen — Revit ↔ Excel" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="Xuất Sheet/View/Revision, chỉnh Excel, xem thay đổi cũ → mới rồi tạo hoặc cập nhật; không tự Save hay Sync Central."
                 Foreground="#56616F"/>
    </StackPanel>

    <WrapPanel x:Name="SheetToolsToolbar" Grid.Row="1" Margin="0,0,0,10">
      <Button x:Name="ExportButton" Content="Xuất model ra Excel" Click="Export_Click" Padding="12,7" Margin="0,0,8,8"/>
      <Button x:Name="BrowseWorkbookButton" Content="Chọn workbook" Click="Browse_Click" Padding="12,7" Margin="0,0,8,8"/>
      <Button x:Name="OpenWorkbookButton" Content="Mở Excel" Click="OpenWorkbook_Click" Padding="12,7" Margin="0,0,8,8"/>
      <TextBox x:Name="WorkbookPathBox" MinWidth="320" Width="650" Padding="7" Margin="0,0,8,8" VerticalContentAlignment="Center" TextChanged="WorkbookPath_Changed"/>
      <Button x:Name="PreviewButton" Content="Đọc &amp; xem trước" Click="Preview_Click" Padding="12,7" Margin="0,0,8,8"/>
    </WrapPanel>

    <Grid Grid.Row="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="#F5ECF8" BorderBrush="#D8BFE1" BorderThickness="1" Padding="10" Margin="0,0,0,8">
        <TextBlock TextWrapping="Wrap">
          <Run FontWeight="SemiBold" Text="Quy trình: "/>
          <Run Text="1) Xuất workbook  2) Trong Excel đặt APPLY=TRUE, chọn CREATE/UPDATE  3) Đọc &amp; xem trước  4) Chỉ các dòng Ready mới được Apply. "/>
          <Run Text="Plan view cần Level; UPDATE không đổi loại/Level. REVISION tạo/cập nhật revision; Sheet tham chiếu revision mới bằng key:ISSUE_A hoặc sequence có sẵn. Tọa độ viewport theo mm."/>
        </TextBlock>
      </Border>
      <DataGrid x:Name="PreviewGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                IsReadOnly="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Nhóm" Binding="{Binding Kind}" Width="85"/>
          <DataGridTextColumn Header="Dòng Excel" Binding="{Binding ExcelRow}" Width="80"/>
          <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="90"/>
          <DataGridTextColumn Header="Sheet / View / Revision" Binding="{Binding Key}" Width="220"/>
          <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="110"/>
          <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="230"/>
          <DataGridTextColumn Header="Thay đổi cũ → mới / Chi tiết" Binding="{Binding Message}" Width="*">
            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <Grid x:Name="SheetToolsFooter" Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="Sẵn sàng" Foreground="#6C2B91" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis"/>
      <WrapPanel Grid.Column="1">
        <Button x:Name="ApplyButton" Content="Apply các dòng Ready" Click="Apply_Click" Padding="14,7" Margin="0,0,8,0"
                Background="#A84CC1" Foreground="White" IsEnabled="False"/>
        <Button x:Name="CloseButton" Content="Đóng" Click="Close_Click" Padding="18,7"/>
      </WrapPanel>
    </Grid>
  </Grid>
</Window>

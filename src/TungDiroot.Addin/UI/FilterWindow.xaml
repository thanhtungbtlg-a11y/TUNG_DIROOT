<Window x:Class="TungDiroot.Addin.UI.FilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TUNG_DIROOT — Filter" Width="1500" Height="900" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  </Window.Resources>
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="TUNG Filter — Tìm và thao tác phần tử" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="Lọc theo category, family, type và parameter; kết quả được xử lý an toàn trong model hiện tại."
                   Foreground="#56616F" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <ComboBox x:Name="ProfileBox" MinWidth="170" DisplayMemberPath="Name" Margin="8,0" Padding="6"/>
        <Button Content="Nạp profile" Click="LoadProfile_Click" Padding="12,6"/>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="250">
      <Grid MinWidth="920">
        <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
        <GroupBox x:Name="ScopeSection" Header="1. Phạm vi" Margin="0,0,6,0">
          <Grid Margin="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,7">
              <TextBlock Text="Nguồn" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <ComboBox x:Name="ScopeBox" SelectedValue="{Binding Scope}" SelectedValuePath="Value" DisplayMemberPath="Label"
                        MinWidth="170" Padding="5" Margin="0,0,8,0"/>
              <Button Content="Nạp lại danh mục" Click="RefreshCatalog_Click" Padding="12,6"/>
            </WrapPanel>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <GroupBox Header="Category" Margin="0,0,4,0">
                <ListBox ItemsSource="{Binding Categories}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                  <ListBox.ItemTemplate><DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="{Binding Name}" Padding="2"/>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </GroupBox>
              <GroupBox Grid.Column="1" Header="Family" Margin="4,0">
                <ListBox ItemsSource="{Binding Families}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                  <ListBox.ItemTemplate><DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="{Binding Name}" Padding="2"/>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </GroupBox>
              <GroupBox Grid.Column="2" Header="Type" Margin="4,0,0,0">
                <ListBox ItemsSource="{Binding Types}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                  <ListBox.ItemTemplate><DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="{Binding Name}" Padding="2"/>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </GroupBox>
            </Grid>
          </Grid>
        </GroupBox>

        <GroupBox x:Name="RulesSection" Grid.Column="1" Header="2. Điều kiện" Margin="6,0,0,0">
          <Grid Margin="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="120"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,6">
              <TextBlock Text="Kết hợp" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <ComboBox x:Name="JoinBox" SelectedValue="{Binding Join}" SelectedValuePath="Value" DisplayMemberPath="Label"
                        MinWidth="180" Padding="5"/>
            </WrapPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Rules}" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" HeadersVisibility="Column" EnableRowVirtualization="True">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Parameter" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <ComboBox ItemsSource="{Binding DataContext.Parameters, RelativeSource={RelativeSource AncestorType=Window}}"
                            SelectedItem="{Binding SelectedParameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            DisplayMemberPath="Name" Padding="3"/>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Phép so sánh" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <ComboBox ItemsSource="{Binding AvailableOperatorOptions}" SelectedValuePath="Value" DisplayMemberPath="Label"
                            SelectedValue="{Binding SelectedOperator, Mode=TwoWay}" Padding="3"/>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Giá trị" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <TextBox Text="{Binding Operand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding RequiresOperand}" Padding="4"/>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="38"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <Button Content="×" ToolTip="Xóa điều kiện" Padding="6,2"
                          Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}"/>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="2" Margin="0,7,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button Content="+ Thêm điều kiện" Command="{Binding AddRuleCommand}" Padding="10,5"/>
              <TextBlock Grid.Column="1" Text="{Binding ValidationText}" Foreground="#B42318" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0"/>
              <Button Grid.Column="2" Content="Chạy lọc" Command="{Binding RunCommand}" Padding="18,6" Background="#A84CC1" Foreground="White"/>
            </Grid>
          </Grid>
        </GroupBox>
      </Grid>
    </ScrollViewer>

    <GroupBox x:Name="ResultsSection" Grid.Row="2" Header="3. Kết quả" Margin="0,8,0,0">
      <Grid Margin="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,6">
          <Button Content="Chọn tất cả" Command="{Binding SelectAllResultsCommand}" Padding="10,5" Margin="0,0,6,0"/>
          <Button Content="Bỏ chọn" Command="{Binding ClearResultsSelectionCommand}" Padding="10,5" Margin="0,0,12,0"/>
          <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" Foreground="#56616F"/>
        </WrapPanel>
        <DataGrid x:Name="ResultsGrid" Grid.Row="1" ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False" EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Chọn" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate>
              <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTextColumn Header="Element ID" Binding="{Binding ElementId, Mode=OneWay}" IsReadOnly="True" Width="95"/>
            <DataGridTextColumn Header="Category" Binding="{Binding Category, Mode=OneWay}" IsReadOnly="True" Width="160"/>
            <DataGridTextColumn Header="Family" Binding="{Binding Family, Mode=OneWay}" IsReadOnly="True" Width="180"/>
            <DataGridTextColumn Header="Type" Binding="{Binding TypeName, Mode=OneWay}" IsReadOnly="True" Width="180"/>
            <DataGridTextColumn Header="Level" Binding="{Binding Level, Mode=OneWay}" IsReadOnly="True" Width="140"/>
            <DataGridTextColumn Header="Điều kiện khớp" Binding="{Binding MatchedRuleCount, Mode=OneWay}" IsReadOnly="True" Width="120"/>
            <DataGridTextColumn Header="Unique ID" Binding="{Binding UniqueId, Mode=OneWay}" IsReadOnly="True" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </GroupBox>

    <GroupBox x:Name="ActionsSection" Grid.Row="3" Header="4. Hành động" Margin="0,8,0,0">
      <Grid Margin="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel>
          <Button Content="Chọn + zoom" Command="{Binding SelectAndShowCommand}" Padding="11,6" Margin="0,0,6,6"/>
          <Button Content="Cô lập tạm" Command="{Binding TemporaryIsolateCommand}" Padding="11,6" Margin="0,0,6,6"/>
          <Button Content="Ẩn tạm" Command="{Binding TemporaryHideCommand}" Padding="11,6" Margin="0,0,6,6"/>
          <Button Content="Bỏ ẩn / cô lập tạm" Command="{Binding ResetTemporaryIsolationCommand}" Padding="11,6" Margin="0,0,6,6"/>
          <Button Content="Lưu Selection Filter" Command="{Binding SaveSelectionSetCommand}" Padding="11,6" Margin="0,0,6,6"/>
          <Button Content="Xuất Excel" Command="{Binding ExportExcelCommand}" Padding="11,6" Margin="0,0,6,6"/>
          <Button Content="Tạo / cập nhật view 3D" Command="{Binding VisualizeCommand}" Padding="11,6" Margin="0,0,12,6" Background="#2A7DAF" Foreground="White"/>
        </WrapPanel>
        <WrapPanel Grid.Row="1">
          <TextBlock Text="Tên profile" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox Text="{Binding ProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="170" Padding="5" Margin="0,0,8,0"/>
          <TextBlock Text="Nhóm màu theo" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox ItemsSource="{Binding Parameters}" SelectedItem="{Binding GroupParameter, Mode=TwoWay}" DisplayMemberPath="Name"
                    MinWidth="180" Padding="5" Margin="0,0,8,0"/>
          <Button Content="Lưu profile" Command="{Binding SaveProfileCommand}" Padding="11,6"/>
        </WrapPanel>
      </Grid>
    </GroupBox>

    <Grid x:Name="FooterPanel" Grid.Row="4" Margin="0,8,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding StatusText}" Foreground="#6C2B91" TextTrimming="CharacterEllipsis"/>
        <ProgressBar Height="4" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
      </StackPanel>
      <Button Grid.Column="1" Content="Hủy" Command="{Binding CancelCommand}" Padding="14,6" Margin="8,0"/>
      <Button x:Name="CloseButton" Grid.Column="2" Content="Đóng" Click="Close_Click" Padding="16,6"/>
    </Grid>
  </Grid>
</Window>

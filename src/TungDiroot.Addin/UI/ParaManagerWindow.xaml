<Window x:Class="TungDiroot.Addin.UI.ParaManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TUNG_DIROOT — ParaManager" Width="1500" Height="900"
        MinWidth="800" MinHeight="580" WindowStartupLocation="CenterScreen">
  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10">
      <TextBlock Text="ParaManager — Project / Shared / Family Parameters" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock x:Name="ScopeText" Foreground="#56616F"/>
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Shared Parameter TXT" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBox x:Name="SharedPathBox" Grid.Column="1" Padding="7" Margin="0,0,8,0"/>
      <Button Grid.Column="2" Content="Chọn TXT" Click="BrowseShared_Click" Padding="12,7"/>
    </Grid>

    <WrapPanel x:Name="ParaManagerToolbar" Grid.Row="2" Margin="0,0,0,10">
      <Button x:Name="ExportButton" Content="Xuất inventory" Click="Export_Click" Padding="12,7" Margin="0,0,8,8"/>
      <Button Content="Chọn workbook" Click="BrowseWorkbook_Click" Padding="12,7" Margin="0,0,8,8"/>
      <Button x:Name="OpenButton" Content="Mở Excel" Click="Open_Click" Padding="12,7" Margin="0,0,8,8"/>
      <TextBox x:Name="WorkbookPathBox" Width="620" MinWidth="300" Padding="7" Margin="0,0,8,8"/>
      <Button x:Name="PreviewButton" Content="Đọc &amp; xem trước" Click="Preview_Click" Padding="12,7" Margin="0,0,8,8"/>
    </WrapPanel>

    <Border Grid.Row="3" Background="#F5ECF8" BorderBrush="#D8BFE1" BorderThickness="1" Padding="10" Margin="0,0,0,8">
      <TextBlock TextWrapping="Wrap" Text="UPDATE: không tự đổi INSTANCE/TYPE; Project chỉ merge thêm category và giữ category cũ. CREATE_SHARED cần TXT, SHARED_GROUP và NAME khớp definition. Shared/built-in không được đổi tên. Chỉ dòng APPLY=TRUE và Ready mới chạy."/>
    </Border>

    <DataGrid x:Name="PreviewGrid" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
              CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Dòng" Binding="{Binding ExcelRow}" Width="60"/>
        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="110"/>
        <DataGridTextColumn Header="Parameter" Binding="{Binding Name}" Width="220"/>
        <DataGridTextColumn Header="Binding" Binding="{Binding Binding}" Width="90"/>
        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="110"/>
        <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="240"/>
        <DataGridTextColumn Header="Mô tả" Binding="{Binding Message}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>

    <Grid x:Name="ParaManagerFooter" Grid.Row="5" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="Sẵn sàng" Foreground="#6C2B91" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <WrapPanel Grid.Column="1">
        <Button x:Name="ApplyButton" Content="Apply các dòng Ready" Click="Apply_Click" Padding="14,7" Margin="0,0,8,0"
                Background="#A84CC1" Foreground="White" IsEnabled="False"/>
        <Button x:Name="CloseButton" Content="Đóng" Click="Close_Click" Padding="18,7"/>
      </WrapPanel>
    </Grid>
  </Grid>
</Window>

<Window x:Class="TungDiroot.Addin.UI.DocumentLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TUNG_DIROOT — PDF / Word Link" Width="1320" Height="820"
        MinWidth="780" MinHeight="560" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12">
      <TextBlock Text="Liên kết PDF / Word — Revit" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="Chọn trang, DPI và cách xếp; mỗi tài liệu được tạo và cập nhật trong giao dịch riêng." Foreground="#56616F"/>
    </StackPanel>

    <Border Grid.Row="1" BorderBrush="#D7DCE2" BorderThickness="1" Padding="12" Margin="0,0,0,10">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="3*"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Nguồn" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="SourcePathBox" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,8,8" Padding="7"
                 IsReadOnly="True" ToolTip="Kéo thả một hoặc nhiều PDF/Word vào cửa sổ."/>
        <Button Grid.Column="4" Grid.ColumnSpan="2" Content="Chọn PDF / Word…" Click="Browse_Click" Padding="12,7" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" Text="Trang" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="PagesBox" Grid.Row="1" Grid.Column="1" Text="1" Padding="7" Margin="0,0,12,8"
                 ToolTip="Ví dụ: 1,3,5-7"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="DPI" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <ComboBox x:Name="DpiBox" Grid.Row="1" Grid.Column="3" Padding="7" Margin="0,0,12,8"/>
        <TextBlock Grid.Row="1" Grid.Column="4" Text="Số cột" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="ColumnsBox" Grid.Row="1" Grid.Column="5" Text="1" Padding="7" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Text="Tên View" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="ViewNameBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Padding="7" Margin="0,0,12,0"/>
        <CheckBox x:Name="RelativePathCheck" Grid.Row="2" Grid.Column="4" Content="Ưu tiên đường dẫn tương đối" IsChecked="True"
                  VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Button x:Name="ImportButton" Grid.Row="2" Grid.Column="5" Content="Nhập và liên kết" Click="Import_Click"
                Padding="14,8" Background="#A84CC1" Foreground="White"/>
      </Grid>
    </Border>

    <WrapPanel Grid.Row="2" Margin="0,0,0,10">
      <Button Content="Kiểm tra nguồn" Click="Refresh_Click" Padding="11,6" Margin="0,0,8,8"/>
      <Button Content="Cập nhật đã chọn" Click="UpdateSelected_Click" Padding="11,6" Margin="0,0,8,8" Background="#A84CC1" Foreground="White"/>
      <Button Content="Mở View" Click="OpenView_Click" Padding="11,6" Margin="0,0,8,8"/>
      <Button Content="Mở nguồn" Click="OpenSource_Click" Padding="11,6" Margin="0,0,8,8"/>
      <Button Content="Unlink — giữ View" Click="Unlink_Click" Padding="11,6" Margin="0,0,8,8"/>
      <Button Content="Xóa link + View" Click="Delete_Click" Padding="11,6" Margin="0,0,8,8" Foreground="#B3261E"/>
    </WrapPanel>

    <DataGrid x:Name="LinksGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              SelectionUnit="FullRow" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Chọn" Width="55">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" IsReadOnly="True" Width="105"/>
        <DataGridTextColumn Header="Nguồn" Binding="{Binding SourcePath}" IsReadOnly="True" Width="*"/>
        <DataGridTextColumn Header="Loại" Binding="{Binding SourceKind}" IsReadOnly="True" Width="70"/>
        <DataGridTextColumn Header="Trang" Binding="{Binding Pages}" IsReadOnly="True" Width="90"/>
        <DataGridTextColumn Header="DPI" Binding="{Binding Dpi}" IsReadOnly="True" Width="70"/>
        <DataGridTextColumn Header="Cột" Binding="{Binding Columns}" IsReadOnly="True" Width="55"/>
        <DataGridTextColumn Header="View đích" Binding="{Binding TargetViewName}" IsReadOnly="True" Width="220"/>
        <DataGridTextColumn Header="Cập nhật cuối" Binding="{Binding LastUpdated}" IsReadOnly="True" Width="145"/>
      </DataGrid.Columns>
    </DataGrid>

    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock x:Name="StatusText" Text="Sẵn sàng" Foreground="#6C2B91" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="Theo dõi nguồn chỉ báo Changed; không tự Save model và không Synchronize with Central." Foreground="#56616F"/>
      </StackPanel>
      <Button Grid.Column="1" Content="Đóng" Click="Close_Click" Padding="18,7"/>
    </Grid>
  </Grid>
</Window>
